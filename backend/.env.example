# Copy to backend/.env. Keep the real file private; it is ignored by git.
# Optional remote API protection. Leave empty for loopback-only local use.
# Remote /api/* requests are denied unless this is a strong token (32+ characters).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real token or paste it into chat.
LINUXCORE_ACCESS_TOKEN=
